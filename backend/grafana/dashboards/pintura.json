          "queryText": "SELECT ts AS time, CAST(strftime('%s','now') AS INTEGER) - ts AS \"Atraso\"\nFROM leituras ORDER BY ts DESC, id DESC LIMIT 1",
          "rawQueryText": "SELECT ts AS time, CAST(strftime('%s','now') AS INTEGER) - ts AS \"Atraso\"\nFROM leituras ORDER BY ts DESC, id DESC LIMIT 1",
