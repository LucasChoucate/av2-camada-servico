            "type": "frser-sqlite-datasource",
            "uid": "sqlite-pintura"
          },
          "queryText": "SELECT $__unixEpochGroupSeconds(ts, 60) AS time, COUNT(*) AS \"Leituras/min\"\nFROM leituras WHERE ts >= $__from / 1000 AND ts < $__to / 1000\nGROUP BY 1 ORDER BY 1",
          "rawQueryText": "SELECT $__unixEpochGroupSeconds(ts, 60) AS time, COUNT(*) AS \"Leituras/min\"\nFROM leituras WHERE ts >= $__from / 1000 AND ts < $__to / 1000\nGROUP BY 1 ORDER BY 1",
