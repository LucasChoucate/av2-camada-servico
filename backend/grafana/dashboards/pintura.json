    {
      "id": 11,
      "type": "timeseries",
      "title": "Leituras recebidas por minuto",
      "description": "Saúde da comunicação: com envio a cada 2 s o esperado é ~30/min.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sqlite-pintura"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
