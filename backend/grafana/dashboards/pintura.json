    {
      "id": 7,
      "type": "timeseries",
      "title": "Nível do tanque de tinta (%)",
      "description": "Faixa vermelha = nível crítico (< 20%).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "sqlite-pintura"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "sqlite-pintura"
          },
          "queryText": "SELECT (ts / MAX(1, $__interval_ms / 1000)) * MAX(1, $__interval_ms / 1000) AS time, AVG(nivel_tinta) AS \"Nível (%)\"\nFROM leituras WHERE ts >= $__from / 1000 AND ts < $__to / 1000\nGROUP BY 1 ORDER BY 1",
          "rawQueryText": "SELECT (ts / MAX(1, $__interval_ms / 1000)) * MAX(1, $__interval_ms / 1000) AS time, AVG(nivel_tinta) AS \"Nível (%)\"\nFROM leituras WHERE ts >= $__from / 1000 AND ts < $__to / 1000\nGROUP BY 1 ORDER BY 1",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": 30000,
            "showPoints": "never",
            "gradientMode": "opacity",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": 20
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "2s"
    },
